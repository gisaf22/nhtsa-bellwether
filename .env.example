# Lakebase (Postgres) connection. Copy to .env and fill in.
#
# Stored as discrete variables rather than a postgresql:// URI on purpose:
# the role is an email address, and the '@' breaks URI parsing.

LAKEBASE_HOST=
LAKEBASE_PORT=5432
LAKEBASE_DB=databricks_postgres
LAKEBASE_USER=
LAKEBASE_SSLMODE=require

# NOT a static password. Lakebase authenticates with a short-lived Databricks
# OAuth token that expires within the hour, so anything long-running must mint
# a fresh one rather than reuse this value. Generate with:
#   databricks auth token -p <profile>
LAKEBASE_PASSWORD=

# Profile used to mint the token above.
DATABRICKS_PROFILE=
